{
  "name": "doit4jesus",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:strict": "expo lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit",
    "check:dependencies": "node scripts/quality-gate.mjs --dependencies",
    "verify:commit": "node scripts/quality-gate.mjs --mode=commit",
    "verify:push": "node scripts/quality-gate.mjs --mode=push",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' jest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' jest --runInBand --coverage",
    "fe-ts": "supabase gen types typescript --project-id sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH > src/interfaces/database.ts",
    "db-webhook-ts": "supabase gen types typescript --project-id sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH > supabase/functions/database-webhook/types.ts",
    "resend-ts": "supabase gen types typescript --project-id sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH > supabase/functions/resend/types.ts",
    "db-ts": "npm run fe-ts && npm run resend-ts && npm run db-webhook-ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.styles.{ts,tsx}",
      "!src/**/index.{ts,tsx}",
      "!src/app/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "private": true
}
